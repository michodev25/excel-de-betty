---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#164c40" />
    <meta name="description" content="Edita precios y productos mayoristas desde cualquier pantalla y descarga un listado Excel con fecha." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    <title>Listado de precios · Editor</title>
  </head>
  <body>
    <a class="skip-link" href="#catalogTitle">Saltar al catálogo</a>
    <div class="app-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Ir al inicio del listado de precios">
          <span class="brand-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none"><path d="M6 7h20v18H6zM6 13h20M13 13v12M20 13v12M6 19h20" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </span>
          <span>LISTADO <small>DE PRECIOS</small></span>
        </a>
        <div class="topbar-right">
          <span class="save-state"><span class="save-dot" aria-hidden="true"></span> Cambios guardados en este dispositivo</span>
          <button class="button button-primary header-export" id="exportTop" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3h16v-3"/></svg>
            Descargar Excel
          </button>
        </div>
      </header>

      <main>
        <section class="intro" aria-labelledby="pageTitle">
          <div class="intro-copy">
            <div class="eyebrow"><span class="eyebrow-line"></span> HERRAMIENTA DE EDICIÓN</div>
            <h1 id="pageTitle">Tu listado,<br /><em>siempre al día.</em></h1>
            <p>Actualiza precios y agrega productos sin perder el formato del Excel original. Cada descarga lleva la fecha que elijas.</p>
          </div>
          <div class="intro-aside">
            <div class="date-card">
              <label for="listDate">Fecha del listado</label>
              <input id="listDate" type="date" required />
              <p>Se usará en el nombre del archivo y en la pestaña.</p>
            </div>
            <div class="edition-tag"><span>EDICIÓN</span><strong id="datePreview">—</strong></div>
          </div>
        </section>

        <section class="overview" aria-label="Resumen del catálogo">
          <div class="metric"><span class="metric-label">Productos</span><strong id="totalCount">—</strong><span class="metric-note">en el catálogo</span></div>
          <div class="metric"><span class="metric-label">Con precio</span><strong id="pricedCount">—</strong><span class="metric-note">listos para consultar</span></div>
          <div class="metric metric-warn"><span class="metric-label">Sin precio</span><strong id="missingCount">—</strong><span class="metric-note">pendientes de completar</span></div>
          <div class="metric"><span class="metric-label">Categorías</span><strong id="categoryCount">—</strong><span class="metric-note">grupos de productos</span></div>
        </section>

        <section class="catalog" aria-labelledby="catalogTitle">
          <div class="catalog-heading">
            <div>
              <div class="section-index">01 / CATÁLOGO</div>
              <h2 id="catalogTitle">Productos y precios</h2>
              <p>Toca cualquier precio para cambiarlo. Los demás datos se editan desde cada producto.</p>
            </div>
            <div class="catalog-actions">
              <button class="button button-ghost import-product" id="importExcel" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21V9m0 0 4 4m-4-4-4 4M4 7V4h16v3"/></svg>
                Importar Excel
              </button>
              <button class="button button-primary add-product" id="addProduct" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Añadir producto
              </button>
              <input id="importFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden />
            </div>
          </div>

          <div class="toolbar">
            <label class="search-field" for="searchInput">
              <span class="sr-only">Buscar producto o proveedor</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
              <input id="searchInput" type="search" placeholder="Buscar producto o proveedor" autocomplete="off" />
            </label>
            <label class="filter-field" for="categoryFilter">
              <span>Categoría</span>
              <select id="categoryFilter"><option value="">Todas las categorías</option></select>
            </label>
            <label class="checkbox-filter" for="missingOnly"><input id="missingOnly" type="checkbox" /> <span>Solo sin precio</span></label>
          </div>

          <div class="results-line"><span id="resultCount" role="status" aria-live="polite">—</span><span class="legend"><i></i> Edita el precio directamente</span></div>

          <div class="desktop-table-wrap">
            <table class="products-table">
              <thead><tr><th scope="col">Producto</th><th scope="col">Formato</th><th scope="col">UM</th><th scope="col">Precio</th><th scope="col">Empresa</th><th scope="col">Red social</th><th scope="col"><span class="sr-only">Acciones</span></th></tr></thead>
              <tbody id="desktopRows"></tbody>
            </table>
          </div>
          <div class="mobile-list" id="mobileList"></div>
          <div class="empty-state" id="emptyState" hidden><strong>No hay productos con estos filtros.</strong><span>Prueba otra búsqueda o agrega un producto nuevo.</span></div>
        </section>
      </main>

      <footer class="site-footer"><span>LISTADO DE PRECIOS</span><span>Tu catálogo se guarda automáticamente en este navegador.</span></footer>
    </div>

    <div class="mobile-export-bar"><span><small>Excel con fecha</small><strong id="mobileDatePreview">—</strong></span><button class="button button-primary" id="exportMobile" type="button">Descargar Excel</button></div>

    <dialog id="productDialog" class="product-dialog" aria-labelledby="dialogTitle">
      <form id="productForm" novalidate>
        <div class="dialog-head">
          <div><span class="section-index" id="dialogEyebrow">PRODUCTO</span><h2 id="dialogTitle">Añadir producto</h2></div>
          <button type="button" class="icon-button" id="closeDialog" aria-label="Cerrar ventana">×</button>
        </div>
        <div class="dialog-scroll">
          <div class="form-grid">
            <label class="field field-full">Producto <span>*</span><input name="product" required maxlength="160" placeholder="Ej. ACEITE DE SOYA 1 L" /></label>
            <label class="field">Categoría <span>*</span><select name="category" required></select></label>
            <label class="field" id="newCategoryField" hidden>Nueva categoría <span>*</span><input name="newCategory" maxlength="80" placeholder="Nombre de la categoría" /></label>
            <label class="field">Formato<input name="format" maxlength="100" placeholder="Ej. Botella 1 L" /></label>
            <label class="field">Unidad de medida<select name="unit"><option>UNIDAD</option><option>CAJA</option><option>SACO</option><option>BOLSA</option><option>LATA</option><option>ESTUCHE</option><option>SET</option><option>TETRA</option><option>VIDRIO</option><option>TONELADA</option><option>LITRO</option><option>POR DEFINIR</option></select></label>
            <label class="field">Precio<input name="price" type="text" inputmode="decimal" placeholder="Ej. 3,50" /></label>
            <label class="field">Nombre de la empresa<input name="supplier" maxlength="160" /></label>
            <label class="field field-full">Dirección<input name="address" maxlength="240" /></label>
            <label class="field">Red social<select name="social"><option value="">Sin indicar</option><option>WHATSAPP</option><option>FACEBOOK</option><option>INSTAGRAM</option><option>TIKTOK</option><option>WEB</option><option>OTRO</option></select></label>
            <label class="field field-full">Observaciones<textarea name="notes" rows="3" maxlength="500" placeholder="Detalles de oferta, presentación o proveedor"></textarea></label>
          </div>
          <div class="original-notes" id="originalNotes" hidden><strong>Comentarios del Excel original</strong><div id="originalNotesContent"></div></div>
        </div>
        <div class="dialog-actions"><button type="button" class="button button-danger" id="deleteProduct" hidden>Eliminar</button><span class="dialog-spacer"></span><button type="button" class="button button-ghost" id="cancelDialog">Cancelar</button><button type="submit" class="button button-primary">Guardar producto</button></div>
      </form>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script src="../scripts/app.ts"></script>
  </body>
</html>
